# Salin menjadi .env lalu isi nilainya. Jangan commit file .env.

# Koneksi PostgreSQL (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/internal_bee?schema=public"

# Kunci penanda tangan sesi login (JWT HS256). Wajib acak & panjang.
# Buat dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
