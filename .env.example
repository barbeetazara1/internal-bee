# Salin menjadi .env lalu isi nilainya. Jangan commit file .env.

# Koneksi PostgreSQL (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/internal_bee?schema=public"

# Kunci penanda tangan sesi login (JWT HS256). Wajib acak & panjang.
# Buat dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# --- Opsional ---
# Penyimpanan bukti pembayaran di Vercel Blob (store PRIVATE). Diisi otomatis oleh Vercel
# saat Blob store dihubungkan ke project. Kosong = simpan di folder lokal storage/bill-proofs.
# BLOB_READ_WRITE_TOKEN=""

# Cookie sesi diberi flag Secure di production. Isi "false" HANYA bila production diakses lewat http (tanpa HTTPS).
# COOKIE_SECURE="false"
